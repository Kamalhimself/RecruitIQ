# PostgreSQL
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/recruitiq

# Groq (JD and CV parsing)
GROQ_API_KEY=

# Google Drive: personal account OAuth (recommended)
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_DRIVE_CREDENTIALS_FILE=drive_credentials.json
GOOGLE_DRIVE_TOKEN_FILE=drive_token.json
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_DRIVE_JD_ROOT_FOLDER_ID=
GOOGLE_DRIVE_TALENT_POOL_FOLDER_ID=
# Only needed when GOOGLE_DRIVE_AUTH_MODE=service_account with a Shared Drive.
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# Google Sheets service account
GOOGLE_SHEET_ID=

# Gmail OAuth. Create an OAuth desktop-app credential in Google Cloud, then
# set this to its downloaded JSON file. token.json is created on first login.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_SENDER_EMAIL=

# Matching
CHROMA_PERSIST_DIRECTORY=chroma_data
MATCH_SHORTLIST_THRESHOLD=70
